# Copy to .env and fill in. Never commit .env.
# Values here are safe defaults for local development with `make dev` / `make services`.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Where links in emails/SMS point, and the GitHub OAuth redirect base.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Shown by /api/v1/health. Set by CI / the host at deploy time.
APP_VERSION=0.1.0
GIT_COMMIT_SHA=

# --- Database / cache / queue ---------------------------------------------
DATABASE_URL=postgres://skillproof:skillproof@localhost:5433/skillproof
REDIS_URL=redis://localhost:6379/0
# true = Celery tasks run inline in the web process (no worker needed locally).
CELERY_TASK_ALWAYS_EAGER=true

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# GitHub OAuth app (Settings → Developer settings → OAuth Apps). The callback URL registered on
# GitHub must equal GITHUB_OAUTH_REDIRECT_URI. Without a frontend, use the dev page below.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/dev-callback
# Dev-only sign-in pages at /api/v1/auth/github/dev-login (ignored by production settings).
GITHUB_DEV_CALLBACK_ENABLED=true
# Required in production. Dev derives one from DJANGO_SECRET_KEY when empty.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Version label of the terms/privacy text, stored with every consent record.
POLICY_VERSION=2026-11-v1

# --- Analysis -------------------------------------------------------------
# Fine-grained token with public read access. Used when the job seeker hasn't linked GitHub and
# for admin/demo analyses. Without it GitHub allows only 60 requests/hour.
GITHUB_TOKEN=
ANALYSIS_CACHE_HOURS=24
ANALYSIS_MAX_REPOS=15
ANALYSIS_COMMIT_SAMPLE=20
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Empty = claude-opus-5-5. Without LLM_API_KEY summaries use the deterministic template.
LLM_MODEL=
# Repos fetched in parallel per analysis
ANALYSIS_FETCH_WORKERS=5

# --- Email (Mailpit locally: SMTP 1025, UI http://localhost:8025) -----------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=SkillProof <no-reply@skillproof.app>

# --- Thrivewave SMS (dry run until the organisers share the API docs) -----
SMS_DRY_RUN=true
THRIVEWAVE_BASE_URL=
THRIVEWAVE_API_KEY=
THRIVEWAVE_USERNAME=
THRIVEWAVE_SENDER_ID=
THRIVEWAVE_SMS_PATH=/sms/send
THRIVEWAVE_WEBHOOK_SECRET=

# --- Runtime (container) -------------------------------------------------
# all = migrate + gunicorn + Celery worker/beat in one container (RumptyCloud); web/worker/beat
# for separate containers (docker-compose.prod.yml).
ROLE=all
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
# Production only. Set false if the platform doesn't send X-Forwarded-Proto (redirect loop).
SECURE_SSL_REDIRECT=true
# Extra trusted origins for Django admin forms; https://<each allowed host> is added automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Password for every seed_demo account
DEMO_PASSWORD=SkillProof-demo-2026

# --- Observability --------------------------------------------------------
# json (default, for log aggregation) or text (easier to read in a terminal)
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=

# End-to-end test servers only: multiplies every API rate limit (sign-ins, refresh, anon, user).
# Leave at 1 in development and production.
THROTTLE_SCALE=1
